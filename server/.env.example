# Copy to `.env` and adjust values for local development.
# `.env` is gitignored; this file is the template that ships with the repo.

# Address the HTTP server binds to.
SERVER_ADDR=0.0.0.0:3000

# Tracing filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=tengri_server=debug,tower_http=debug,axum::rejection=trace
RUST_LOG=tengri_server=debug,tower_http=info

# Postgres connection (local docker-compose default).
DATABASE_URL=postgres://tengri:tengri@localhost:5432/tengri

# Postgres for the integration test suite. Must be a *separate* database — the
# test harness drops & recreates the `public` schema on every `cargo test` run.
# Create it once per machine:
#   docker exec tengri-postgres createdb -U tengri tengri_test
TEST_DATABASE_URL=postgres://tengri:tengri@localhost:5432/tengri_test

# Optional: domain Leonardo used for `leonardo_*` cookies. After Tengri accepts
# a legacy `leonardo_data` autologin cookie, it sends expired `leonardo_*`
# cookies for this domain so the browser drops the old Leonardo login state.
# Set without a leading dot, e.g. `leo.example.com`; leave empty for host-only
# deletion.
LEONARDO_COOKIE_DOMAIN=

# Public base URL of this API, including the `/api` prefix — the same value the
# SPA uses as VITE_SERVER_URL. OAuth redirect URIs are built as
# `${API_PUBLIC_URL}/oauth/{provider}/callback` and must match exactly what's
# registered with each provider. Trailing slash trimmed. Defaults to
# `http://localhost:5757/api` when unset.
API_PUBLIC_URL=http://localhost:5757/api

# Public origin of the SPA. OAuth callbacks redirect the browser back to
# `${APP_BASE_URL}{return_to}`. Trailing slash trimmed. Defaults to
# `http://localhost:5173` when unset.
APP_BASE_URL=http://localhost:5173

# Deploy only (scripts/deploy-*.sh); the server binary never reads these.
# Public https base of the prod deployment. The deploy scripts poll
# `${PROD_SERVER_ORIGIN}/api/health` (server) and `/` (client) to confirm a
# rollout went live.
PROD_SERVER_ORIGIN=

# ssh(1) host of the prod box, as named in ~/.ssh/config. That entry must carry
# `LocalForward 5000 127.0.0.1:5000` so `docker push` reaches the server's
# loopback registry over the tunnel; the deploy scripts also ssh here to restart
# the systemd service.
PROD_SERVER_SSH_HOST=